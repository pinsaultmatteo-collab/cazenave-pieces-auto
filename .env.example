# Copier ce fichier en .env.local et renseigner les valeurs.
# .env* est ignoré par git : ne jamais committer de secrets.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opisto (API v2.15) -------------------------------------------------
# preprod = https://api-preprod.opisto.fr:8443 | prod = https://api.opisto.fr
OPISTO_ENV=preprod
OPISTO_USERNAME=
OPISTO_PASSWORD=
OPISTO_CASSE_ID=7
OPISTO_SECRET_ID=

# --- Base de données (Neon Postgres, via Vercel) ------------------------
DATABASE_URL=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Recherche par plaque d'immatriculation ------------------------------
PLATE_API_KEY=

# --- Synchronisation du stock (appelée par GitHub Actions ou Vercel Cron)
SYNC_SECRET=
