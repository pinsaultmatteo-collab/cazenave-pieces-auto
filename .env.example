# Copier ce fichier en .env.local et renseigner les valeurs.
# .env* est ignoré par git : ne jamais committer de secrets.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opisto (API v2.15) -------------------------------------------------
# preprod = https://api-preprod.opisto.fr:8443 | prod = https://api.opisto.fr
OPISTO_ENV=preprod
OPISTO_USERNAME=
OPISTO_PASSWORD=
OPISTO_CASSE_ID=7
OPISTO_SECRET_ID=

# --- Base de données ----------------------------------------------------
# Vide en développement : Postgres embarqué (PGlite) dans .data/pglite.
# Sur Vercel : chaîne de connexion Neon (pooled), ex. postgresql://...neon.tech/neondb?sslmode=require
DATABASE_URL=
# Source du catalogue : db (défaut) ou demo (jeu de démonstration)
CATALOG_SOURCE=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Recherche par plaque d'immatriculation ------------------------------
PLATE_API_KEY=

# --- Synchronisation du stock (POST /api/sync, appelée par GitHub Actions)
# Jeton partagé avec le workflow .github/workflows/sync-opisto.yml
SYNC_SECRET=
# Budget de temps par appel (ms, défaut 45000) et fréquence du parcours complet (heures, défaut 24)
SYNC_BUDGET_MS=
SYNC_FULL_EVERY_HOURS=
